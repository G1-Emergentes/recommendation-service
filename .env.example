# IAM validates users/sessions. History lives in a DIFFERENT Supabase project.
# disabled: unavailable; demo: synthetic wardrobe; live: authenticated Digital Closet HTTP.
RECOMMENDATION_MODE=disabled
RECOMMENDATION_ENGINE=category_rules
RECOMMENDATION_PORT=8085
DIGITAL_CLOSET_BASE_URL=http://127.0.0.1:8081
DIGITAL_CLOSET_TIMEOUT_SECONDS=10
IAM_BASE_URL=http://127.0.0.1:8080
IAM_TIMEOUT_SECONDS=25
IAM_SUPABASE_URL=https://YOUR-AUTH-PROJECT.supabase.co
# Leave empty until the independent project is provisioned.
RECOMMENDATION_SUPABASE_URL=
# Backend only: never put this key in Flutter, Swagger or version control.
RECOMMENDATION_SUPABASE_SECRET_KEY=
# To use the real model: RECOMMENDATION_ENGINE=nemotron and fill NVIDIA_API_KEY.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=30
# Embeddings configuration; the RAG pipeline is not enabled yet.
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_EMBEDDING_DIMENSIONS=1024
NVIDIA_EMBEDDING_TIMEOUT_SECONDS=30
# Dedicated Neon vector store. Backend credential; not consumed by the bot yet.
NEON_VECTOR_DATABASE_URL=
NEON_VECTOR_PROJECT_ID=
NEON_VECTOR_BRANCH_ID=
RECOMMENDATION_RAG_ENABLED=false
# Official origin by default; loopback is reserved for isolated HTTP tests.
NVIDIA_EMBEDDING_API_ORIGIN=https://integrate.api.nvidia.com
# Public academic source, no API key. Fixed FashionStylist repository/revision.
FASHION_WEB_TIMEOUT_SECONDS=5
# Leave the official origin; loopback override is only for isolated HTTP tests.
FASHION_WEB_ORIGIN=https://raw.githubusercontent.com
